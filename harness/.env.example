# Copy to .env and fill in for a real (non-mock) run.
# config.py loads this automatically via python-dotenv.

LYZR_API_KEY=
LYZR_AGENT_ID=
# Optional: point the naive baseline at a bigger/pricier model on purpose.
# Defaults to LYZR_AGENT_ID if unset.
LYZR_BASELINE_AGENT_ID=
LYZR_USER_ID=hrithikgh29@gmail.com

# Pricing used for cost metrics (USD per 1M tokens) — set to match whatever
# model backs LYZR_AGENT_ID / LYZR_BASELINE_AGENT_ID.
PRICE_INPUT_PER_M=0.25
PRICE_OUTPUT_PER_M=1.25

# Optional override; defaults to harness/data/track_a_logs.csv
DATA_PATH=

# Set to 1 to use the local mock oracle instead of the real API (not submittable).
LYZR_MOCK=0

# Majority-vote k calls per signature in the optimized pipeline (default 1 = off).
# See README "Sample real runs" before turning this on — it trades cost cut for
# stability against LLM sampling noise, but can't fix a systematic model
# preference (only random variance). Override per-run with `run.py --vote-k N`.
VOTE_K=1

# Tool-calling: on ownership-sensitive categories, ground the classification
# with a simulated service-ownership (CMDB) lookup before deciding — see
# README "Tool-calling closes the gap". Default on (1). Set to 0 or pass
# `run.py --no-tools` to compare against the un-grounded configuration.
TOOLS_ENABLED=1
